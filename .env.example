# ==========================================
# Pluto AI Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Security & Authentication
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Defaults to SQLite for seamless zero-config local development.
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/pluto_ai
DATABASE_URL=sqlite:///./pluto_ai.db

# AI Provider API Keys
# Pluto AI supports Google Gemini, Groq, and OpenAI via a unified provider abstraction.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (Ultra-fast OpenAI-compatible provider)
GROQ_API_KEY=

# Google Gemini API (Recommended for Multimodal Vision & Reasoning)
GEMINI_API_KEY=

# Default Active Model
# Options: gemini-1.5-flash, gemini-2.0-flash, gpt-4o-mini, llama-3.3-70b-versatile
DEFAULT_MODEL=gemini-1.5-flash
DEFAULT_PROVIDER=gemini

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173,http://127.0.0.1:5173

# Storage Paths
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
