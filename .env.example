# ==========================================
# Nova AI Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Security & Authentication
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=nova_ai_super_secret_jwt_and_session_key_replace_in_prod_948f2190
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Defaults to SQLite for seamless zero-config local development.
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/nova_ai
DATABASE_URL=sqlite:///./nova_ai.db

# AI Provider API Keys
# Nova AI supports OpenAI, Groq, Ollama, and Google Gemini via a unified provider abstraction.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (Ultra-fast OpenAI-compatible provider)
GROQ_API_KEY=

# Google Gemini API
GEMINI_API_KEY=

# Default Active Model
# Options: gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile, llama-3.1-8b-instant, gemini-1.5-flash
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_PROVIDER=openai

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173,http://127.0.0.1:5173

# Storage Paths
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
