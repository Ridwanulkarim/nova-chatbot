# ==========================================
# Pluto AI Environment Configuration
# ==========================================

# Application Environment ("development" or "production")
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Security & Authentication (MANDATORY IN PRODUCTION)
# In production or on Vercel, the application will refuse to start if SECRET_KEY is default or empty.
# Generate a secure key using: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=pluto_ai_default_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Defaults to SQLite for seamless zero-config local development.
# For Production / Vercel: Ephemeral SQLite (/tmp/pluto_ai.db) resets on serverless cold starts.
# To keep users, conversations, and documents persistent across deployments, use managed PostgreSQL:
# Examples:
# DATABASE_URL=postgresql://user:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://user:password@ep-cool-dawn-12345.us-east-2.aws.neon.tech/neondb
DATABASE_URL=sqlite:///./pluto_ai.db

# AI Provider API Keys
# Google Gemini API (Recommended for Multimodal Vision & Pixel-Level Reasoning)
GEMINI_API_KEY=

# Groq (Ultra-fast text completions & reasoning)
GROQ_API_KEY=

# OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Default Active Model & Provider
# Gemini: gemini-3.5-flash, gemini-3-flash-preview, gemini-3.8-flash
DEFAULT_MODEL=gemini-3.5-flash
DEFAULT_PROVIDER=gemini

# CORS Settings (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload & Storage Settings
# Upload directory for local storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Persistent Cloud Object Storage (Optional for production / Vercel persistence)
# Set STORAGE_BACKEND=s3 to store documents directly in AWS S3, Cloudflare R2, or Supabase Storage
STORAGE_BACKEND=local
# S3_BUCKET_NAME=my-pluto-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com  # Cloudflare R2 / MinIO
# S3_REGION_NAME=auto

# Daily Quota Limits
DAILY_MESSAGE_LIMIT=50
DAILY_IMAGE_LIMIT=10

# Firebase Authentication (Frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
